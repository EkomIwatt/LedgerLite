# LedgerLite backend configuration.
#
# Copy to backend/.env for local development. .env is gitignored; .env.example
# is not. Never commit a real SECRET_KEY.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# "development" | "production". In production the app refuses to boot with a
# missing, placeholder, or short SECRET_KEY, and refuses SameSite=None without
# Secure.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local docker-compose:
DATABASE_URL=postgresql+asyncpg://ledgerlite:ledgerlite@localhost:5432/ledgerlite
#
# Neon / Render paste their URL in libpq form, e.g.
#   postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Paste it as-is. app/database.py forces the +asyncpg driver, enables SSL, and
# strips the libpq-only query args (sslmode, channel_binding) that asyncpg
# rejects outright.

# Log every SQL statement. Noisy; debugging only.
SQL_ECHO=false

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me

ACCESS_TOKEN_TTL_SECONDS=900        # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000   # 30 days

# How long a just-rotated refresh token still answers instead of being treated
# as theft (Contract 1, Amendment 1). Two tabs share a cookie jar but not a
# single-flight promise, so the losing tab posts the cookie the winner just
# rotated -- a benign race, not a stolen token. Inside this window, and only
# while the family is still live, that replay gets a fresh access token.
# Outside it, the whole family is revoked. Set to 0 to disable the window.
REFRESH_REPLAY_GRACE_SECONDS=10

# ---------------------------------------------------------------------------
# Refresh cookie
# ---------------------------------------------------------------------------
# Local dev: the frontend proxies /api to :8000, so requests are same-origin
# and Lax + insecure works over plain http.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
#
# Production (Vercel UI + Render API are different origins):
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
# Browsers only honour SameSite=None over HTTPS, so these two move together.

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# The EXACT frontend origin, no trailing slash, no wildcard -- a wildcard is
# invalid alongside allow_credentials=True and silently breaks the cookie.
# Comma-separate to add a Vercel preview origin.
#
# NOTE: the deployed Vercel origin is often not the bare project name
# (Snipp's was snipp-kappa.vercel.app). Confirm the real one at deploy time.
FRONTEND_ORIGIN=http://localhost:5173
