# ---------------------------------------------------------------------------
# LedgerLite frontend environment
# Copy to `.env.local` (git-ignored) and adjust.
# ---------------------------------------------------------------------------

# Base URL the API client prefixes onto every request path.
#
# Local development: leave EMPTY. Requests then go to /api/... on the Vite dev
# server, which proxies them to http://localhost:8000 (see vite.config.ts).
# Same-origin is required for the SameSite=Lax dev refresh cookie to be sent.
#
# Production (Vercel): set to the deployed API origin, no trailing slash, e.g.
#   VITE_API_BASE_URL=https://ledgerlite-api.onrender.com
# Cross-origin in production is why the backend sets SameSite=None; Secure.
VITE_API_BASE_URL=

# When "true", every request is served by the in-browser mock backend in
# src/api/mocks.ts instead of the network. Used for UI development and demos
# without a running API. Anything other than "true" means real network calls.
VITE_USE_MOCKS=false
